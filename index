    <!-- ============================================================
    JAVASCRIPT PER MENU (masing-masing fungsi terpisah)
    ============================================================ -->
    <script type="module">
        // ================================================================
        // 1. NAVIGASI (bersama)
        // ================================================================
        const buttons = document.querySelectorAll('.nav-links button');
        const pages = {
            beranda: document.getElementById('beranda'),
            materi: document.getElementById('materi'),
            video: document.getElementById('video'),
            simulasi: document.getElementById('simulasi'),
            kuis: document.getElementById('kuis'),
            evaluasi: document.getElementById('evaluasi'),
            profil: document.getElementById('profil')
        };

        let simInitialized = false;

        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                buttons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                const pageId = btn.dataset.page;
                Object.keys(pages).forEach(key => {
                    pages[key].classList.toggle('active', key === pageId);
                });
                // Lazy load simulasi 3D
                if (pageId === 'simulasi' && !simInitialized) {
                    initSimulasi();
                }
            });
        });

        // ================================================================
        // 2. KUIS (fungsi khusus menu Kuis)
        // ================================================================
        const kuisData = [
            { q: 'Apa fungsi utama spindle pada mesin bubut?', o: ['Memutar benda kerja', 'Menggerakkan pahat', 'Mendinginkan benda', 'Menjepit pahat'], a: 0 },
            { q: 'Bagian yang berfungsi sebagai penyangga benda kerja panjang adalah...', o: ['Kepala tetap', 'Kepala lepas', 'Eretan', 'Chuck'], a: 1 },
            { q: 'Jika kecepatan putar (RPM) terlalu tinggi, hasil permukaan cenderung...', o: ['Kasar', 'Halus', 'Tidak berubah', 'Bergelombang'], a: 1 },
            { q: 'Satuan untuk kecepatan pemakanan (feed) adalah...', o: ['mm/putaran', 'RPM', 'mm/menit', 'N/m²'], a: 0 },
            { q: 'Pahat yang digunakan untuk membuat alur dinamakan...', o: ['Grooving tool', 'Turning tool', 'Threading tool', 'Parting tool'], a: 0 },
            { q: 'Bagian mesin yang membawa pahat dan bergerak sepanjang bed adalah...', o: ['Carriage', 'Spindle', 'Tailstock', 'Lead screw'], a: 0 },
            { q: 'Kedalaman potong (DOC) yang terlalu dalam dapat menyebabkan...', o: ['Pahat cepat aus', 'Permukaan halus', 'Spindle berhenti', 'Benda kerja memuai'], a: 0 },
            { q: 'Pendingin (coolant) digunakan untuk...', o: ['Mengurangi panas & gesekan', 'Mengeraskan benda kerja', 'Mempercepat putaran', 'Membersihkan pahat'], a: 0 },
            { q: 'Chuck pada mesin bubut berfungsi untuk...', o: ['Menjepit benda kerja', 'Memutar pahat', 'Mengatur kecepatan', 'Menahan tailstock'], a: 0 },
            { q: 'Proses membubut permukaan ujung benda kerja disebut...', o: ['Facing', 'Turning', 'Grooving', 'Drilling'], a: 0 }
        ];

        function renderKuis() {
            const container = document.getElementById('kuisContainer');
            container.innerHTML = '';
            kuisData.forEach((item, idx) => {
                const div = document.createElement('div');
                div.className = 'quiz-box';
                div.innerHTML = `<div class="q"><span>${idx+1}.</span> ${item.q}</div>`;
                item.o.forEach((opt, oi) => {
                    const label = document.createElement('label');
                    label.innerHTML = `<input type="radio" name="k${idx}" value="${oi}"> ${opt}`;
                    div.appendChild(label);
                });
                container.appendChild(div);
            });
        }
        renderKuis();

        document.getElementById('kuisSubmit').addEventListener('click', () => {
            let benar = 0;
            kuisData.forEach((item, idx) => {
                const selected = document.querySelector(`input[name="k${idx}"]:checked`);
                if (selected && parseInt(selected.value) === item.a) benar++;
            });
            const res = document.getElementById('kuisResult');
            res.textContent = `Nilai Kuis: ${benar} / ${kuisData.length} (${Math.round(benar/kuisData.length*100)}%)`;
            res.style.color = benar === kuisData.length ? '#16a34a' : benar >= 6 ? '#eab308' : '#dc2626';
        });

        // ================================================================
        // 3. EVALUASI (Pretest & Posttest)
        // ================================================================
        const pretestData = [
            { q: 'Mesin bubut digunakan untuk memproses benda kerja yang...', o: ['Berputar', 'Diam', 'Bergerak translasi', 'Bergetar'], a: 0 },
            { q: 'Nama lain dari kepala tetap adalah...', o: ['Headstock', 'Tailstock', 'Carriage', 'Bed'], a: 0 },
            { q: 'Parameter yang mengatur tebal sayatan pahat adalah...', o: ['DOC', 'RPM', 'Feed', 'Clearance'], a: 0 },
            { q: 'Pahat potong (parting tool) digunakan untuk...', o: ['Memotong benda kerja', 'Membuat ulir', 'Menghaluskan', 'Membuat alur'], a: 0 },
            { q: 'Alat yang digunakan untuk menjepit benda kerja pada mesin bubut adalah...', o: ['Chuck', 'Collet', 'Vise', 'Jig'], a: 0 }
        ];

        const posttestData = [
            { q: 'Jika diameter benda kerja 40 mm dan kecepatan potong 25 m/min, maka RPM yang tepat sekitar...', o: ['200', '400', '800', '1600'], a: 1 },
            { q: 'Pahat HSS memiliki ketahanan panas hingga...', o: ['400°C', '600°C', '900°C', '1200°C'], a: 1 },
            { q: 'Gerakan pahat yang sejajar dengan sumbu benda kerja disebut...', o: ['Feeding axial', 'Feeding radial', 'Facing', 'Grooving'], a: 0 },
            { q: 'Fungsi lead screw pada mesin bubut adalah...', o: ['Menggerakkan carriage otomatis', 'Memutar spindle', 'Menahan tailstock', 'Mengatur RPM'], a: 0 },
            { q: 'Jenis pahat yang memiliki ujung berbentuk runcing untuk membuat ulir adalah...', o: ['Threading tool', 'Turning tool', 'Grooving tool', 'Boring tool'], a: 0 }
        ];

        function renderEval(containerId, data) {
            const container = document.getElementById(containerId);
            container.innerHTML = '';
            data.forEach((item, idx) => {
                const div = document.createElement('div');
                div.className = 'quiz-box';
                div.innerHTML = `<div class="q"><span>${idx+1}.</span> ${item.q}</div>`;
                item.o.forEach((opt, oi) => {
                    const label = document.createElement('label');
                    label.innerHTML = `<input type="radio" name="${containerId}${idx}" value="${oi}"> ${opt}`;
                    div.appendChild(label);
                });
                container.appendChild(div);
            });
        }
        renderEval('pretestContainer', pretestData);
        renderEval('posttestContainer', posttestData);

        function evalScore(containerId, data, resultId) {
            let benar = 0;
            data.forEach((item, idx) => {
                const selected = document.querySelector(`input[name="${containerId}${idx}"]:checked`);
                if (selected && parseInt(selected.value) === item.a) benar++;
            });
            const res = document.getElementById(resultId);
            res.textContent = `Skor: ${benar} / ${data.length} (${Math.round(benar/data.length*100)}%)`;
            res.style.color = benar === data.length ? '#16a34a' : benar >= 3 ? '#eab308' : '#dc2626';
        }

        document.getElementById('pretestSubmit').addEventListener('click', () => {
            evalScore('pretestContainer', pretestData, 'pretestResult');
        });
        document.getElementById('posttestSubmit').addEventListener('click', () => {
            evalScore('posttestContainer', posttestData, 'posttestResult');
        });

        // ================================================================
        // 4. SIMULASI 3D (fungsi terpisah, dipanggil saat menu dibuka)
        // ================================================================
        async function initSimulasi() {
            if (simInitialized) return;
            simInitialized = true;

            const THREE = await import('three');
            const { OrbitControls } = await import('three/addons/controls/OrbitControls.js');

            const container = document.getElementById('sim3d-container');
            if (!container) return;

            // refs UI sim
            const rpmSlider = document.getElementById('simRpm');
            const depthSlider = document.getElementById('simDepth');
            const rpmVal = document.getElementById('simRpmVal');
            const depthVal = document.getElementById('simDepthVal');
            const diamDisplay = document.getElementById('simDiameter');
            const toolPosDisplay = document.getElementById('simToolPos');
            const startBtn = document.getElementById('simStart');
            const stopBtn = document.getElementById('simStop');
            const resetBtn = document.getElementById('simReset');

            // Scene
            const scene = new THREE.Scene();
            scene.background = new THREE.Color(0x121820);
            scene.fog = new THREE.Fog(0x121820, 20, 40);

            const width = container.clientWidth;
            const height = container.clientHeight || 600;
            const camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 50);
            camera.position.set(9, 6, 11);
            camera.lookAt(0, 0.8, 0);

            const renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(width, height);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            renderer.toneMapping = THREE.ACESFilmicToneMapping;
            renderer.toneMappingExposure = 1.2;
            container.appendChild(renderer.domElement);

            const controls = new OrbitControls(camera, renderer.domElement);
            controls.target.set(0, 0.8, 0);
            controls.enableDamping = true;
            controls.dampingFactor = 0.08;
            controls.maxPolarAngle = Math.PI / 2.2;
            controls.minDistance = 3;
            controls.maxDistance = 25;

            // Lights
            const ambientLight = new THREE.AmbientLight(0x404060, 0.5);
            scene.add(ambientLight);
            const hemiLight = new THREE.HemisphereLight(0x87ceeb, 0x362d1e, 0.6);
            scene.add(hemiLight);
            const mainLight = new THREE.DirectionalLight(0xffeedd, 1.8);
            mainLight.position.set(8, 15, 10);
            mainLight.castShadow = true;
            mainLight.shadow.mapSize.width = 1024;
            mainLight.shadow.mapSize.height = 1024;
            mainLight.shadow.camera.near = 0.1;
            mainLight.shadow.camera.far = 30;
            mainLight.shadow.camera.left = -10;
            mainLight.shadow.camera.right = 10;
            mainLight.shadow.camera.top = 10;
            mainLight.shadow.camera.bottom = -10;
            scene.add(mainLight);
            const fillLight = new THREE.DirectionalLight(0x4488ff, 0.4);
            fillLight.position.set(-5, 2, 8);
            scene.add(fillLight);
            const rimLight = new THREE.DirectionalLight(0xffffff, 0.3);
            rimLight.position.set(-2, 1, -8);
            scene.add(rimLight);

            // Floor
            const floorGeo = new THREE.PlaneGeometry(30, 30);
            const floorMat = new THREE.ShadowMaterial({ opacity: 0.5 });
            const floor = new THREE.Mesh(floorGeo, floorMat);
            floor.rotation.x = -Math.PI / 2;
            floor.position.y = -0.1;
            floor.receiveShadow = true;
            scene.add(floor);
            const gridHelper = new THREE.GridHelper(20, 20, 0x3a4a6a, 0x1a2a3a);
            gridHelper.position.y = -0.05;
            scene.add(gridHelper);

            // Lathe Group
            const latheGroup = new THREE.Group();
            scene.add(latheGroup);

            // Materials
            const matBody = new THREE.MeshStandardMaterial({ color: 0x2c3e50, roughness: 0.5, metalness: 0.4 });
            const matBodyLight = new THREE.MeshStandardMaterial({ color: 0x3b4d61, roughness: 0.4, metalness: 0.3 });
            const matChuck = new THREE.MeshStandardMaterial({ color: 0x4a5a6a, roughness: 0.6, metalness: 0.7 });
            const matSteel = new THREE.MeshStandardMaterial({ color: 0x8a9aaa, roughness: 0.3, metalness: 0.8 });
            const matToolPost = new THREE.MeshStandardMaterial({ color: 0x9b2c2c, roughness: 0.6, metalness: 0.2 });
            const matCarriage = new THREE.MeshStandardMaterial({ color: 0x1e4a6e, roughness: 0.4, metalness: 0.5 });
            const matBrass = new THREE.MeshStandardMaterial({ color: 0xd4a373, roughness: 0.3, metalness: 0.6 });
            const legMat = new THREE.MeshStandardMaterial({ color: 0x1e2a3a, roughness: 0.7, metalness: 0.3 });
            const jawMat = new THREE.MeshStandardMaterial({ color: 0x5a6a7a, roughness: 0.7, metalness: 0.6 });
            const screwMat = new THREE.MeshStandardMaterial({ color: 0x6a7a8a, roughness: 0.5, metalness: 0.7 });
            const nozzleMat = new THREE.MeshStandardMaterial({ color: 0x1a2a3a, roughness: 0.6, metalness: 0.3 });

            // --- Build Lathe ---
            const bed = new THREE.Mesh(new THREE.BoxGeometry(12, 0.3, 2.2), matBody);
            bed.position.set(0, 0.1, 0);
            bed.castShadow = true;
            bed.receiveShadow = true;
            latheGroup.add(bed);
            const bedTop = new THREE.Mesh(new THREE.BoxGeometry(11.5, 0.1, 1.8), matBodyLight);
            bedTop.position.set(0, 0.35, 0);
            bedTop.castShadow = true;
            bedTop.receiveShadow = true;
            latheGroup.add(bedTop);

            const legPositions = [
                [-5.2, -0.3, 0.8],
                [-5.2, -0.3, -0.8],
                [5.2, -0.3, 0.8],
                [5.2, -0.3, -0.8]
            ];
            legPositions.forEach(pos => {
                const leg = new THREE.Mesh(new THREE.BoxGeometry(0.25, 0.5, 0.25), legMat);
                leg.position.set(pos[0], pos[1], pos[2]);
                leg.castShadow = true;
                leg.receiveShadow = true;
                latheGroup.add(leg);
            });

            const headstock = new THREE.Mesh(new THREE.BoxGeometry(1.4, 1.0, 1.6), matBodyLight);
            headstock.position.set(-5.0, 0.8, 0);
            headstock.castShadow = true;
            headstock.receiveShadow = true;
            latheGroup.add(headstock);
            const cover = new THREE.Mesh(new THREE.BoxGeometry(0.8, 0.4, 0.8), new THREE.MeshStandardMaterial({ color: 0x1e3a5f, roughness: 0.5, metalness: 0.4 }));
            cover.position.set(-5.0, 1.4, 0);
            cover.castShadow = true;
            latheGroup.add(cover);
            const spindleNose = new THREE.Mesh(new THREE.CylinderGeometry(0.6, 0.7, 0.2, 24), matSteel);
            spindleNose.rotation.z = Math.PI / 2;
            spindleNose.position.set(-4.35, 0.8, 0);
            spindleNose.castShadow = true;
            latheGroup.add(spindleNose);

            const chuckGroup = new THREE.Group();
            chuckGroup.position.set(-4.0, 0.8, 0);
            latheGroup.add(chuckGroup);
            const chuckBody = new THREE.Mesh(new THREE.CylinderGeometry(0.75, 0.75, 0.5, 24), matChuck);
            chuckBody.rotation.z = Math.PI / 2;
            chuckBody.castShadow = true;
            chuckGroup.add(chuckBody);
            for (let i = 0; i < 3; i++) {
                const angle = (i / 3) * Math.PI * 2;
                const jaw = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.25, 0.08), jawMat);
                jaw.position.set(0.3, Math.sin(angle) * 0.5, Math.cos(angle) * 0.5);
                jaw.rotation.x = angle;
                jaw.castShadow = true;
                chuckGroup.add(jaw);
            }

            let workRadius = 1.2;
            const workLength = 6.5;
            let workpieceMesh;
            const workMat = new THREE.MeshStandardMaterial({ color: 0xe67e22, roughness: 0.3, metalness: 0.7, emissive: new THREE.Color(0x4a2a0a), emissiveIntensity: 0.1 });

            function createWorkpiece(radius) {
                if (workpieceMesh) { workpieceMesh.geometry.dispose();
                    latheGroup.remove(workpieceMesh); }
                const geo = new THREE.CylinderGeometry(radius, radius, workLength, 32);
                geo.rotateZ(Math.PI / 2);
                workpieceMesh = new THREE.Mesh(geo, workMat);
                workpieceMesh.position.set(-0.75, 0.8, 0);
                workpieceMesh.castShadow = true;
                workpieceMesh.receiveShadow = true;
                latheGroup.add(workpieceMesh);
                return workpieceMesh;
            }
            createWorkpiece(workRadius);

            const tailstock = new THREE.Mesh(new THREE.BoxGeometry(1.0, 0.8, 0.9), matBodyLight);
            tailstock.position.set(5.2, 0.6, 0);
            tailstock.castShadow = true;
            tailstock.receiveShadow = true;
            latheGroup.add(tailstock);
            const quill = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, 0.6, 12), matSteel);
            quill.rotation.z = Math.PI / 2;
            quill.position.set(4.7, 0.8, 0);
            quill.castShadow = true;
            latheGroup.add(quill);
            const centerTip = new THREE.Mesh(new THREE.ConeGeometry(0.12, 0.2, 12), matSteel);
            centerTip.rotation.z = -Math.PI / 2;
            centerTip.position.set(4.4, 0.8, 0);
            centerTip.castShadow = true;
            latheGroup.add(centerTip);
            const handwheel = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.3, 0.08, 16), matBrass);
            handwheel.rotation.x = Math.PI / 2;
            handwheel.position.set(5.7, 0.8, 0);
            handwheel.castShadow = true;
            latheGroup.add(handwheel);

            const carriageGroup = new THREE.Group();
            carriageGroup.position.set(3.5, 0.35, 0.6);
            latheGroup.add(carriageGroup);
            const carriage = new THREE.Mesh(new THREE.BoxGeometry(0.7, 0.2, 0.6), matCarriage);
            carriage.position.set(0, 0.1, 0);
            carriage.castShadow = true;
            carriage.receiveShadow = true;
            carriageGroup.add(carriage);
            const toolPost = new THREE.Mesh(new THREE.BoxGeometry(0.25, 0.4, 0.25), matToolPost);
            toolPost.position.set(0, 0.4, 0);
            toolPost.castShadow = true;
            carriageGroup.add(toolPost);
            const toolBit = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.06, 0.4), new THREE.MeshStandardMaterial({ color: 0xf5c542, roughness: 0.2, metalness: 0.9 }));
            toolBit.position.set(0, 0.4, 0.2);
            toolBit.castShadow = true;
            carriageGroup.add(toolBit);
            const glowMat = new THREE.MeshBasicMaterial({ color: 0xff8800, transparent: true, opacity: 0.6 });
            const glowSphere = new THREE.Mesh(new THREE.SphereGeometry(0.08, 8, 8), glowMat);
            glowSphere.position.set(0, 0.4, 0.35);
            carriageGroup.add(glowSphere);

            const screw = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 11, 8), screwMat);
            screw.rotation.z = Math.PI / 2;
            screw.position.set(0, 0.2, 0.9);
            screw.castShadow = true;
            latheGroup.add(screw);

            const nozzle = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.06, 0.4, 8), nozzleMat);
            nozzle.rotation.x = 0.3;
            nozzle.position.set(2.0, 1.2, 0.3);
            nozzle.castShadow = true;
            latheGroup.add(nozzle);
            const nozzleTip = new THREE.Mesh(new THREE.SphereGeometry(0.05, 6, 6), new THREE.MeshStandardMaterial({ color: 0x3b82f6, emissive: 0x1a3a6a, emissiveIntensity: 0.2 }));
            nozzleTip.position.set(2.15, 1.0, 0.45);
            latheGroup.add(nozzleTip);

            // --- State Sim ---
            let isRunning = false;
            let currentRadius = 1.2;
            let toolX = 3.5;
            const minRadius = 0.15;
            const maxRadius = 1.2;
            const toolMinX = -3.5;
            const toolMaxX = 3.5;
            let rotationAngle = 0;

            function updateUI() {
                const diameterMm = (currentRadius * 20).toFixed(1);
                diamDisplay.textContent = diameterMm;
                toolPosDisplay.textContent = toolX.toFixed(1);
                rpmVal.textContent = rpmSlider.value;
                depthVal.textContent = parseFloat(depthSlider.value).toFixed(1);
            }

            function updateWorkpieceGeometry(radius) {
                if (workpieceMesh) {
                    workpieceMesh.geometry.dispose();
                    const geo = new THREE.CylinderGeometry(radius, radius, workLength, 36);
                    geo.rotateZ(Math.PI / 2);
                    workpieceMesh.geometry = geo;
                }
            }

            function resetSim() {
                isRunning = false;
                currentRadius = maxRadius;
                toolX = toolMaxX;
                rotationAngle = 0;
                updateWorkpieceGeometry(currentRadius);
                carriageGroup.position.x = toolX;
                workpieceMesh.rotation.x = 0;
                updateUI();
                startBtn.textContent = '▶ Mulai';
            }

            const clock = new THREE.Clock();

            function animate() {
                requestAnimationFrame(animate);
                const delta = clock.getDelta();
                if (delta > 0.05) clock.getDelta();

                if (isRunning) {
                    const rpm = parseFloat(rpmSlider.value);
                    const depth = parseFloat(depthSlider.value);
                    const rotSpeed = (rpm / 60) * 2 * Math.PI;
                    rotationAngle += rotSpeed * delta;
                    workpieceMesh.rotation.x = rotationAngle;

                    const feedSpeed = 0.4 + (rpm / 3000) * 1.2;
                    toolX -= feedSpeed * delta;
                    const cutRate = depth * 0.25 * delta;
                    currentRadius -= cutRate;

                    if (currentRadius < minRadius) currentRadius = minRadius;
                    if (toolX < toolMinX) {
                        toolX = toolMinX;
                        isRunning = false;
                        startBtn.textContent = '▶ Mulai';
                    }
                    updateWorkpieceGeometry(currentRadius);
                    carriageGroup.position.x = toolX;
                    glowSphere.material.opacity = 0.3 + (depth / 2.0) * 0.5;
                    updateUI();
                }
                controls.update();
                renderer.render(scene, camera);
            }
            animate();

            // --- Event Sim ---
            rpmSlider.addEventListener('input', () => {
                rpmVal.textContent = rpmSlider.value;
                if (!isRunning) updateUI();
            });
            depthSlider.addEventListener('input', () => {
                depthVal.textContent = parseFloat(depthSlider.value).toFixed(1);
                if (!isRunning) updateUI();
            });

            startBtn.addEventListener('click', () => {
                if (isRunning) return;
                if (toolX <= toolMinX || currentRadius <= minRadius) resetSim();
                isRunning = true;
                startBtn.textContent = '▶ Berjalan...';
            });
            stopBtn.addEventListener('click', () => {
                if (isRunning) { isRunning = false;
                    startBtn.textContent = '▶ Lanjut'; }
            });
            resetBtn.addEventListener('click', resetSim);

            const resizeObserver = new ResizeObserver(() => {
                const w = container.clientWidth;
                const h = container.clientHeight || 600;
                camera.aspect = w / h;
                camera.updateProjectionMatrix();
                renderer.setSize(w, h);
            });
            resizeObserver.observe(container);

            resetSim();
            console.log('Simulasi 3D dimulai!');
        }

        // ================================================================
        // 5. INISIALISASI AWAL
        // ================================================================
        // Jika halaman dibuka dengan tab Simulasi aktif, inisialisasi
        const activeBtn = document.querySelector('.nav-links button.active');
        if (activeBtn && activeBtn.dataset.page === 'simulasi') {
            setTimeout(() => initSimulasi(), 200);
        }

        console.log('✅ Media Pembelajaran siap! Setiap menu memiliki kode terpisah.');
    </script>
</body>
</html>
